# Copy to .env.local. See docs/operators/frame-deployment.md

# Optional: Supabase vault-media per-user quota in MB (default 3072 via APP_USER_STORAGE_LIMIT_MB in code).
# Set on Vercel Production/Preview only if you override without redeploying; omit to use code default (3 GB).
# VAULT_USER_QUOTA_MB=

# Optional: force non-API capability mode for all users (staging / demos). Omit in production.
# CREATIX_PRODUCT_MODE=non_api_protection
# NEXT_PUBLIC_CREATIX_PRODUCT_MODE=non_api_protection

# Required for vault video editor / frame-session (min 16 characters).
FRAME_BRIDGE_SECRET=

# Optional: Frame server POST export to Creatix
# FRAME_EXPORT_SECRET=

# Wellbeing Flow v2 — dashboard presence telemetry (`scripts/093_user_wellbeing_activity.sql`). Reporter sends heartbeats + meaningful actions unless disabled.
# NEXT_PUBLIC_WELLBEING_FLOW_V2=false          # disable dashboard activity reporter (default: enabled when unset)
# NEXT_PUBLIC_WELLBEING_FLOW_V2=1             # recommended when using server-side Flow v2 merge + dampened tab-away energy boost on the client
# FLOW_V2_LLM=1                                # when OPENAI_API_KEY is set, include presence facts in Pulse + Flow-state LLM prompts

# Optional: Frame app URL (no trailing slash)
# NEXT_PUBLIC_FRAME_URL=https://frame.example.com

# Stripe — checkout, Customer Portal, and POST /api/stripe/webhook
# STRIPE_WEBHOOK_SECRET must be the Signing secret for the SAME endpoint URL Stripe calls (paste from that row).
# LIVE events need the secret from Dashboard with "Test mode" OFF; test/sk_test flows use Test mode webhook secret.
# Stripe CLI (--forward-to) uses a different whsec printed by the CLI — do not mix with Dashboard production secret.
# STRIPE_SECRET_KEY=sk_live_...   # or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_... # Developers → Webhooks → select endpoint matching your deployed /api/stripe/webhook URL
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_... # or pk_test_...
# Webhook must include payment_intent.succeeded and payment_intent.payment_failed for auto credit top-up.

# Automatic credit top-up (off-session PaymentIntents; grant credits in webhook only)
# CREDIT_AUTO_TOPUP_ENABLED=true
# CREDIT_AUTO_TOPUP_DRY_RUN=true
# Optional comma-separated user UUID allowlist (empty = all enabled users)
# CREDIT_AUTO_TOPUP_USER_IDS=
# CREDIT_AUTO_TOPUP_MAX_FAILURES=3
# CREDIT_AUTO_TOPUP_MAX_CHARGES_PER_DAY=8
# CREDIT_AUTO_TOPUP_CRON_BATCH=50

# Divine Voice Premium (Stripe add-on; see docs/internal/divine-voice-premium.md)
# STRIPE_DIVINE_VOICE_PRICE_IDS=price_xxx,price_yyy
# Optional: grant Realtime + premium chat models to all paid users (not for production)
# DIVINE_VOICE_GRANT_ALL_PAID=true
# Optional: max Realtime session starts per user per UTC month (0 = off)
# DIVINE_VOICE_MAX_REALTIME_SESSIONS_PER_MONTH=80
# Markit origin(s) for CORS on Realtime / divine cross-origin (comma-separated, no trailing slash)
# NEXT_PUBLIC_MARKIT_URL=https://markit.example.com,https://markit-xxx.vercel.app
# Same value as Markit — gates POST /api/divine/test-enqueue (optional SSE integration smoke test)
# DIVINE_TEST_ENQUEUE_SECRET=

# Optional: Ariadne Trace signing (falls back to FRAME_BRIDGE_SECRET)
# ARIADNE_SECRET=

# Optional: log OnlyFans/Fansly OAuth connect denials (403 CONNECT_ENTITLEMENT_REQUIRED) with a short SHA-256 prefix of user id — for support or metrics only. Omit in production unless needed.
# PARTNER_CONNECT_DENIAL_LOG=1

# Dashboard → Content → Schedule: annual “Birthday” chip on the orbit calendar (month-day, 1-based month). Omit for default June 15; set to none to hide.
# NEXT_PUBLIC_CONTENT_ORBIT_BIRTHDAY_MD=7-22
# NEXT_PUBLIC_CONTENT_ORBIT_BIRTHDAY_MD=none
