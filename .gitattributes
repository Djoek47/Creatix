# Cross-platform: keep text files as LF in the repo and on checkout (avoids CRLF churn on Windows).
* text=auto eol=lf

# Binary assets — do not touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary
*.zip binary
