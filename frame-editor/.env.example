# Same Supabase project as Circe et Venus (Frame needs auth + subscription reads).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Creatix production URL (AI proxy target).
NEXT_PUBLIC_CREATIX_APP_URL=https://www.circeetvenus.com
NEXT_PUBLIC_FRAMER_TRACED_EXPORT_ENABLED=false
NEXT_PUBLIC_MARKIT_VAULT_LIVE_DETECT_ENABLED=true
NEXT_PUBLIC_MARKIT_VAULT_BRIDGE_RECOVERY_ENABLED=true
NEXT_PUBLIC_MARKIT_TRACE_OPERATIONS_ENABLED=true
NEXT_PUBLIC_MARKIT_RENDER_QUEUE_ENABLED=true
NEXT_PUBLIC_MARKIT_DIVINE_ACTIONS_ENABLED=false
NEXT_PUBLIC_MARKIT_DIVINE_REQUIRE_SIGNED_ENVELOPE=false

# Same value as Creatix FRAME_EXPORT_SECRET (server-only).
FRAME_EXPORT_SECRET=

# Optional: comma-separated hostnames allowed in exportUrl (defaults to circeetvenus.com).
# CREATIX_EXPORT_HOST_ALLOWLIST=www.circeetvenus.com,circeetvenus.com
