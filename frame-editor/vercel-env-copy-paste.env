# Frame editor — paste into Vercel → Project → Settings → Environment Variables
# Add each NAME below; set the VALUE in the dashboard (do not commit real secrets).
# Use Production (and Preview if you want previews to work the same).

# --- Supabase (same project as Creatix) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Creatix (Frame Assist + links); no trailing slash ---
NEXT_PUBLIC_CREATIX_APP_URL=https://www.circeetvenus.com
NEXT_PUBLIC_MARKIT_VAULT_LIVE_DETECT_ENABLED=true
NEXT_PUBLIC_MARKIT_VAULT_BRIDGE_RECOVERY_ENABLED=true
NEXT_PUBLIC_MARKIT_TRACE_OPERATIONS_ENABLED=true
NEXT_PUBLIC_MARKIT_RENDER_QUEUE_ENABLED=true
NEXT_PUBLIC_MARKIT_DIVINE_ACTIONS_ENABLED=false
NEXT_PUBLIC_MARKIT_DIVINE_REQUIRE_SIGNED_ENVELOPE=false

# --- Must match Creatix FRAME_EXPORT_SECRET exactly (Production only is fine) ---
FRAME_EXPORT_SECRET=

# --- Optional: extra hosts for exportUrl (e.g. Vercel preview). Merged with defaults; does not replace them. ---
# CREATIX_EXPORT_HOST_ALLOWLIST=my-app.vercel.app,cetv.app
