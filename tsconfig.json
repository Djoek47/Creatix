{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@openreel/core": [
        "./vendor/openreel/core/index.ts"
      ],
      "@openreel/core/*": [
        "./vendor/openreel/core/*"
      ],
      "@openreel/ui": [
        "./vendor/openreel/ui/index.ts"
      ],
      "@openreel/ui/*": [
        "./vendor/openreel/ui/*"
      ],
      "@openreel/ui/lib/utils": [
        "./vendor/openreel/ui/lib/utils.ts"
      ],
      "@openreel/ui/components/toggle": [
        "./vendor/openreel/ui/components/toggle.tsx"
      ],
      "@openreel/image-core": [
        "./vendor/openreel/image-core/index.ts"
      ],
      "@openreel/image-core/*": [
        "./vendor/openreel/image-core/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps/mobile",
    "frame-editor",
    "vendor/openreel/**/test/**",
    "vendor/openreel/**/*.test.ts",
    "vendor/openreel/**/*.test.tsx",
    "vendor/openreel/core/wasm/**/assembly/**"
  ]
}
